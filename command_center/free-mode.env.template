# Nullkosten-Betrieb, hybrid: Dienste auf dem Server, Modelle (Qwen3) auf dem eigenen Rechner.
# Anleitung: docs/HYBRID_SETUP.md
# Auf dem Server nach command_center/.env kopieren (bestehende Keys dort behalten, aber leer lassen
# was unten leer ist), dann: docker compose -f docker-compose.command-center.yml up -d

# Lokales Qwen3 über das laufende OmniRoute-Gateway (Ollama dahinter, kostenlos)
JARVIS_AI_PROVIDER=omniroute
OMNIROUTE_URL=http://omniroute:20128/v1
# OmniRoute selbst zeigt (in seinem Dashboard) auf Ollama am Rechner: http://100.117.75.70 (BonBon):11434
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=qwen3:4b

# Bezahl-Modelle bleiben aus: free.py ersetzt dann alles durch die Gratis-Kette
JARVIS_ALLOW_PAID=0

# Keine Cloud-Rückfälle, die Credits verbrauchen würden
MIA_TEXT_OPENAI_FALLBACK_MODEL=
MIA_TEXT_OPENAI_FIRST=0
MIA_VOICE_OPENAI_MODEL=
MIA_GROQ_FIRST=0
MIA_GROQ_MODELS=
MIA_GEMINI_FALLBACK_MODEL=
MIA_ANTHROPIC_FALLBACK=0
# Bei Ausfall von OmniRoute lokal weiterantworten statt in die Cloud zu gehen
MIA_CHAT_LOCAL_FALLBACK=1
