# ── JARVIS Command Center — environment ──────────────────────────────────
# Copy to command_center/.env (gitignored). Every secret stays here, on the
# server. Nothing in this file is ever sent to the browser.

# ── first login ──────────────────────────────────────────────────────────
JARVIS_CC_ADMIN_USER=admin
JARVIS_CC_ADMIN_PASSWORD=change-me-before-first-start
# Cookie signing / misc secret (optional: generated into /data/secret.key if empty)
JARVIS_CC_SECRET_KEY=

# ── http ─────────────────────────────────────────────────────────────────
# compose: host interface to publish on (127.0.0.1 behind a reverse proxy)
JARVIS_CC_BIND=127.0.0.1
JARVIS_CC_PORT=8080
# e.g. /jarvis when mounted under a path prefix
JARVIS_CC_ROOT_PATH=
# auto | true | false  (true behind HTTPS)
JARVIS_CC_SECURE_COOKIES=auto
JARVIS_CC_TRUST_PROXY=true
# comma-separated; empty = same-origin only
JARVIS_CC_ALLOWED_ORIGINS=
JARVIS_CC_SESSION_TTL_HOURS=168

# ── master agent ─────────────────────────────────────────────────────────
# auto → local when an AI key is present, remote when JARVIS_GATEWAY_* is set
JARVIS_MASTER_AGENT_MODE=auto
# anthropic | openai | gemini | local  (empty = first configured)
JARVIS_AI_PROVIDER=
# e.g. claude-opus-5 / gpt-4.1 / gemini-flash-latest / llama3.2
JARVIS_AI_MODEL=
ANTHROPIC_API_KEY=
# Only for a key created at organisation level rather than inside a workspace:
# such a key names no workspace of its own and every request is refused with
# 400 until one is given. The id is in the console URL of the workspace.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
# e.g. http://ollama:11434 or http://host.docker.internal:1234
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
JARVIS_CC_MAX_AGENT_STEPS=16
JARVIS_CC_MAX_DELEGATION_DEPTH=2
# tools at this risk level or above pause for approval
JARVIS_CC_APPROVAL_RISK=high
JARVIS_CC_APPROVAL_TIMEOUT_MIN=30
# optional path to a roster JSON (same shape as config/agency.json)
JARVIS_CC_AGENT_ROSTER=

# ── remote master agent (relay to an upstream JARVIS control plane) ──────
# e.g. https://jarvis-reyes.de/jarvis-api
JARVIS_GATEWAY_URL=
JARVIS_GATEWAY_TOKEN=
JARVIS_GATEWAY_ACTOR=command-center

# ── server capabilities (off by default) ─────────────────────────────────
# terminal.execute tool (admin + approval)
JARVIS_CC_ALLOW_TERMINAL=false
# restart containers (needs :rw socket mount)
JARVIS_CC_ALLOW_DOCKER_ACTIONS=false
# systemctl restart of monitored services
JARVIS_CC_ALLOW_SERVICE_RESTART=false
# e.g. nginx,n8n,postgresql
JARVIS_CC_MONITORED_SERVICES=
JARVIS_CC_DOCKER_SOCKET=/var/run/docker.sock
# The host's docker group id. The container runs as a non-root user, so
# without it the socket is unreadable and the Server page says "offline".
# setup-keys.sh detects it; by hand: stat -c '%g' /var/run/docker.sock
# Empty falls back to nogroup, which grants nothing.
JARVIS_CC_DOCKER_GID=

# ── driving the paired PC ────────────────────────────────────────────────
# desktop.run controls the user's own machine, so it asks for approval by
# default. desktop.open_app does not. The PC connects outward with the same
# machine token used for /v1/commands; nothing listens on the PC's network.
JARVIS_CC_DESKTOP_REQUIRE_APPROVAL=true
# seconds to wait for the PC to answer
JARVIS_CC_DESKTOP_TIMEOUT=90

# ── reaching a neighbouring stack (n8n, a database) ──────────────────────
# The docker network of that stack, so its containers resolve by name.
# Empty falls back to the default bridge, which changes nothing. Find it with:
#   docker inspect n8n --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# Only read when compose is called with --env-file command_center/.env, which
# install.sh and setup-keys.sh both do.
JARVIS_CC_SHARED_NETWORK=

# ── composio: one key instead of a dozen (leave empty → NOT CONNECTED) ───
# https://platform.composio.dev → API key. The OAuth for Gmail, Slack, Notion,
# Linear and the rest happens there, not here; this server only asks what is
# connected and runs a tool. A toolkit that is not connected is refused by
# name — nothing is attempted that cannot work.
COMPOSIO_API_KEY=
# Composio scopes connections per end user; "default" is its own convention
COMPOSIO_USER_ID=
# only for a self-hosted or regional Composio
COMPOSIO_BASE_URL=

# ── integrations (leave empty → shown as NOT CONNECTED) ──────────────────
# NOT 127.0.0.1: this server runs in a container, where 127.0.0.1 is the
# container itself. An n8n published as 127.0.0.1:5678 on the host is not
# reachable from here at all. Use the container's name and join its network
# via JARVIS_CC_SHARED_NETWORK below.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=
GITHUB_TOKEN=
# e.g. reyesservice34-hue/Mark-LIII — lets agents omit the repo
GITHUB_DEFAULT_REPO=

# Google Calendar: a refresh token, not a browser flow (the server is headless).
# Leave empty to use the local calendar store instead — it needs no account and
# writes .ics files the desktop reads too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# default: primary
GOOGLE_CALENDAR_ID=

# Mailbox. Host/port are guessed from the address domain when left empty
# (Gmail, Outlook, IONOS, Strato, GMX, web.de, Posteo, mailbox.org, Yahoo).
# Gmail and Outlook need an app password, not the account password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
# true = implicit TLS (465), false = STARTTLS (587)
EMAIL_SMTP_SSL=
# display name on outgoing mail
EMAIL_SENDER_NAME=
# WhatsApp braucht hier keine Zugangsdaten: der Kanal läuft über den
# gekoppelten PC und dessen einmal per QR verknüpftes WhatsApp Web.
IONOS_API_KEY=

# ── voice (optional; any OpenAI-compatible audio endpoint) ───────────────
# Leave empty and the microphone in the browser stays disabled, saying why.
# Self-hostable options: faster-whisper-server, whisper.cpp server, Speaches,
# LocalAI (STT); Kokoro-FastAPI, Piper wrappers, LocalAI (TTS).
# e.g. http://whisper:8000   → POST /v1/audio/transcriptions
JARVIS_CC_STT_URL=
JARVIS_CC_STT_MODEL=whisper-1
# e.g. de — omit to auto-detect
JARVIS_CC_STT_LANGUAGE=
# falls back to OPENAI_API_KEY
JARVIS_CC_STT_API_KEY=
# e.g. http://kokoro:8880    → POST /v1/audio/speech
JARVIS_CC_TTS_URL=
JARVIS_CC_TTS_MODEL=tts-1
JARVIS_CC_TTS_VOICE=alloy
# falls back to OPENAI_API_KEY
JARVIS_CC_TTS_API_KEY=

# ── housekeeping ─────────────────────────────────────────────────────────
JARVIS_CC_LOG_RETENTION_ROWS=50000
JARVIS_CC_MAX_UPLOAD_MB=200
JARVIS_CC_LOG_LEVEL=INFO
