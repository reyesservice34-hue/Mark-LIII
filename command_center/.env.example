# ── JARVIS Command Center — environment ──────────────────────────────────
# Copy to command_center/.env (gitignored). Every secret stays here, on the
# server. Nothing in this file is ever sent to the browser.

# ── first login ──────────────────────────────────────────────────────────
JARVIS_CC_ADMIN_USER=admin
JARVIS_CC_ADMIN_PASSWORD=change-me-before-first-start
# Cookie signing / misc secret (optional: generated into /data/secret.key if empty)
JARVIS_CC_SECRET_KEY=

# ── http ─────────────────────────────────────────────────────────────────
JARVIS_CC_BIND=127.0.0.1        # compose: host interface to publish on (127.0.0.1 behind a reverse proxy)
JARVIS_CC_PORT=8080
JARVIS_CC_ROOT_PATH=            # e.g. /jarvis when mounted under a path prefix
JARVIS_CC_SECURE_COOKIES=auto   # auto | true | false  (true behind HTTPS)
JARVIS_CC_TRUST_PROXY=true
JARVIS_CC_ALLOWED_ORIGINS=      # comma-separated; empty = same-origin only
JARVIS_CC_SESSION_TTL_HOURS=168

# ── master agent ─────────────────────────────────────────────────────────
# auto → local when an AI key is present, remote when JARVIS_GATEWAY_* is set
JARVIS_MASTER_AGENT_MODE=auto
JARVIS_AI_PROVIDER=             # anthropic | openai | gemini | local  (empty = first configured)
JARVIS_AI_MODEL=                # e.g. claude-opus-5 / gpt-4.1 / gemini-flash-latest / llama3.2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
LOCAL_LLM_URL=                  # e.g. http://ollama:11434 or http://host.docker.internal:1234
LOCAL_LLM_MODEL=
JARVIS_CC_MAX_AGENT_STEPS=16
JARVIS_CC_MAX_DELEGATION_DEPTH=2
JARVIS_CC_APPROVAL_RISK=high    # tools at this risk level or above pause for approval
JARVIS_CC_APPROVAL_TIMEOUT_MIN=30
JARVIS_CC_AGENT_ROSTER=         # optional path to a roster JSON (same shape as config/agency.json)

# ── remote master agent (relay to an upstream JARVIS control plane) ──────
JARVIS_GATEWAY_URL=             # e.g. https://jarvis-reyes.de/jarvis-api
JARVIS_GATEWAY_TOKEN=
JARVIS_GATEWAY_ACTOR=command-center

# ── server capabilities (off by default) ─────────────────────────────────
JARVIS_CC_ALLOW_TERMINAL=false          # terminal.execute tool (admin + approval)
JARVIS_CC_ALLOW_DOCKER_ACTIONS=false    # restart containers (needs :rw socket mount)
JARVIS_CC_ALLOW_SERVICE_RESTART=false   # systemctl restart of monitored services
JARVIS_CC_MONITORED_SERVICES=           # e.g. nginx,n8n,postgresql
JARVIS_CC_DOCKER_SOCKET=/var/run/docker.sock

# ── integrations (leave empty → shown as NOT CONNECTED) ──────────────────
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=            # e.g. reyesservice34-hue/Mark-LIII — lets agents omit the repo

# Google Calendar: a refresh token, not a browser flow (the server is headless).
# Leave empty to use the local calendar store instead — it needs no account and
# writes .ics files the desktop reads too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=             # default: primary

# Mailbox. Host/port are guessed from the address domain when left empty
# (Gmail, Outlook, IONOS, Strato, GMX, web.de, Posteo, mailbox.org, Yahoo).
# Gmail and Outlook need an app password, not the account password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_SSL=                 # true = implicit TLS (465), false = STARTTLS (587)
EMAIL_SENDER_NAME=              # display name on outgoing mail
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
IONOS_API_KEY=

# ── voice (optional; any OpenAI-compatible audio endpoint) ───────────────
# Leave empty and the microphone in the browser stays disabled, saying why.
# Self-hostable options: faster-whisper-server, whisper.cpp server, Speaches,
# LocalAI (STT); Kokoro-FastAPI, Piper wrappers, LocalAI (TTS).
JARVIS_CC_STT_URL=              # e.g. http://whisper:8000   → POST /v1/audio/transcriptions
JARVIS_CC_STT_MODEL=whisper-1
JARVIS_CC_STT_LANGUAGE=         # e.g. de — omit to auto-detect
JARVIS_CC_STT_API_KEY=          # falls back to OPENAI_API_KEY
JARVIS_CC_TTS_URL=              # e.g. http://kokoro:8880    → POST /v1/audio/speech
JARVIS_CC_TTS_MODEL=tts-1
JARVIS_CC_TTS_VOICE=alloy
JARVIS_CC_TTS_API_KEY=          # falls back to OPENAI_API_KEY

# ── housekeeping ─────────────────────────────────────────────────────────
JARVIS_CC_LOG_RETENTION_ROWS=50000
JARVIS_CC_MAX_UPLOAD_MB=200
JARVIS_CC_LOG_LEVEL=INFO
